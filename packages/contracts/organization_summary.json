{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrganizationSummary",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "role": { "type": "string" },
