# Finance Intelligence Environment Variables Example
# Duplicate this file to .env for local development

# Application Environment (development, test, staging, production)
ENVIRONMENT=development
DEBUG=true

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Pseudonymization Salt (Min 32 characters required in production)
PSEUDONYMIZATION_SALT=dev-salt-3918204918239012830129

# PostgreSQL Connection Strings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance_intelligence
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Test Environment Database Connection URLs
TEST_OWNER_DATABASE_URL=postgresql+asyncpg://db_owner:dev_owner_pass_123@localhost:5433/finance_intelligence_test
TEST_BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://db_bootstrap:dev_bootstrap_pass_123@localhost:5433/finance_intelligence_test
TEST_API_DATABASE_URL=postgresql+asyncpg://db_api_user:dev_api_user_pass_123@localhost:5433/finance_intelligence_test
TEST_WORKER_DATABASE_URL=postgresql+asyncpg://db_ingestion_worker:dev_worker_pass_123@localhost:5433/finance_intelligence_test
TEST_ROUNDTRIP_DATABASE_URL=postgresql+asyncpg://db_owner:dev_owner_pass_123@localhost:5433/finance_intelligence_roundtrip_test

# Firebase & App Check Config
FIREBASE_PROJECT_ID=finance-intelligence-dev
ENFORCE_APP_CHECK=false

# External Provider Mock Keys (Non-Production Placeholders)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_PLACEHOLDER
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_PLACEHOLDER
